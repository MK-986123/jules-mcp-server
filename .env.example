# Generate the Jules API key privately in https://jules.google.com/settings
# Copy to .env, restrict it to your user, and fill in secrets in an editor.
JULES_API_KEY=your_jules_api_key_here

# Pilot repository selected by Maks. Jules must also have GitHub app access.
JULES_ALLOWED_REPOS=MK-986123/jules-mcp-server

# Generate a separate persistent random encryption key; keep it across restarts.
# Rotating this key requires migrating existing encrypted schedule storage.
JULES_ENCRYPTION_KEY=your_separate_random_encryption_key_here

# Optional absolute path for persistent encrypted schedules.
# Run one bridge process per storage directory to avoid duplicate scheduled tasks.
# JULES_STORAGE_DIR=/absolute/path/to/private/jules-state

# Optional API request timeout and read retry count. Mutations are never replayed.
# JULES_API_TIMEOUT_MS=15000
# JULES_API_MAX_RETRIES=2
